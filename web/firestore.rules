rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function casa() { return get(/databases/$(database)/documents/casa/principal).data; }
    function dono() { return logado() && casa().donoUid == request.auth.uid; }
    function membro() {
      return logado() && (dono() || (request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/membros/$(request.auth.token.email.lower()))));
    }

    // Documento raiz: diz quem é o administrador. Quem criar primeiro vira o dono.
    match /casa/principal {
      allow read: if logado();
      allow create: if logado() && request.resource.data.donoUid == request.auth.uid;
      allow update: if dono() && request.resource.data.donoUid == resource.data.donoUid;
      allow delete: if false;
    }
    // Lançamentos (casa/principal/tx/*) e configuração (casa/principal/dados/config)
    match /casa/principal/{colecao}/{id} {
      allow read, write: if membro();
    }
    // Lista de e-mails liberados: todos os membros veem, só o dono altera
    match /membros/{email} {
      allow read: if membro();
      allow write: if dono() && (request.method == 'delete' || email == email.lower());
    }
  }
}
